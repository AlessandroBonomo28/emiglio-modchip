// =====================================================================
//  Emiglio modchip - PCBWay sponsor screen
//  Display TFT 128x160 ST7735S su CN1 (KF2510-8A) / ESP32-WROOM-32E
//
//  "Proud to announce a new sponsorship by PCBWay!"
//  High quality embedded board production -> https://www.pcbway.com/
//
//  Logo renderizzato come due bitmap 1bpp sovrapposte (wordmark verde +
//  swoosh arancione), 148x42, 798 byte ciascuna. Cosi' si usano i colori
//  reali del marchio con il drawBitmap() nativo di Adafruit_GFX, senza
//  sprecare 12 kB di bitmap RGB565.
//
//  ---------------------------------------------------------------------
//  MAPPATURA CN1 (KF2510-8A)
//   CN1-1 BLK -> +3V3 (LCD_SWITCH)   CN1-5 DC  -> GPIO4
//   CN1-2 SCL -> GPIO18              CN1-6 CS  -> GPIO15
//   CN1-3 SDA -> GPIO23              CN1-7 GND -> GND
//   CN1-4 RES -> GPIO2               CN1-8 VCC -> +3V3 (LCD_SWITCH)
// =====================================================================

#include <Arduino.h>
#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ST7735.h>

// ---------------------------------------------------------------------
//  Pin e configurazione display
// ---------------------------------------------------------------------
