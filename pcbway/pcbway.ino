static constexpr uint16_t GRAM_H = 162;
static constexpr int8_t   TFT_COLSTART = 2;  // offset tarati sul modulo
static constexpr int8_t   TFT_ROWSTART = 1;
static constexpr uint8_t  TFT_ROTATION = 1;  // landscape 160x128
static constexpr uint32_t TFT_SPI_HZ   = 40000000UL;

// ---------------------------------------------------------------------
//  Palette PCBWay (RGB565 calcolato a compile time)
// ---------------------------------------------------------------------
static constexpr uint16_t rgb565(uint8_t r, uint8_t g, uint8_t b)
{
    return (uint16_t)(((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3));
}
static constexpr uint16_t C_GREEN  = rgb565(0x22, 0x8B, 0x3C);   // verde marchio
static constexpr uint16_t C_ORANGE = rgb565(0xE0, 0x66, 0x1E);   // arancio swoosh
static constexpr uint16_t C_BG     = ST77XX_BLACK;
static constexpr uint16_t C_TXT    = ST77XX_WHITE;

// ---------------------------------------------------------------------
//  Il logo. Layer 1: wordmark "PCBWay". Layer 2: swoosh.
// ---------------------------------------------------------------------
